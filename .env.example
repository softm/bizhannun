# Pages direct NTS lookup: the build injects this key into the public runtime.
# All other collection keys below are Actions/server-only; never put them in browser code.
NTS_SERVICE_KEY=
FTC_SERVICE_KEY=
# Optional public registration/search adapters used by scripts/collect-businesses.mjs.
# Each provider requires its own service approval. The common portal key alone is not approval.
BUSINESS_PUBLIC_SERVICE_KEY=
FSC_SERVICE_KEY=
DART_API_KEY=
# Search API credentials; separate from the legacy login OAuth variables below.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
KAKAO_REST_API_KEY=
# Optional fallback for NTS_SERVICE_KEY
DATA_GO_KR_SERVICE_KEY=
# Comma-separated origins permitted to call this server
ALLOWED_ORIGINS=https://softm.github.io,http://localhost:4173,http://127.0.0.1:4173
PORT=4173

# Public Firebase web settings are read from config/firebase-public.json.
# Optional JSON override containing ONLY apiKey, authDomain, projectId, appId,
# storageBucket, messagingSenderId, measurementId. Never a service-account JSON.
FIREBASE_WEB_CONFIG=
# Explicit provider overrides; blank uses the public config file.
FIREBASE_GOOGLE_ENABLED=
FIREBASE_EMAIL_ENABLED=
FIRESTORE_DATABASE_ID=bizhannun
FIRESTORE_EDITION=ENTERPRISE

# Legacy optional server OAuth configuration; not used by the current Pages deployment.
# Public collection does not enable SNS login. Set only for an explicitly operated server.
AUTH_PUBLIC_ORIGIN=
# Generate a random secret with at least 32 characters, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Server-only Firebase service account for social Custom Token minting.
# Use either the JSON variable OR all three separate variables.
# This project MUST match FIREBASE_WEB_CONFIG / config/firebase-public.json.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=biz-hannun
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: share an HTTPS API origin with the static Pages frontend.
# Configure app-config.js (a public URL only), not a service key.
